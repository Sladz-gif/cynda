# Development mode - set to true to bypass authentication and use mock data
DEV_MODE=true

# Supabase — service-role key, NEVER the anon key, NEVER committed to git
# Only required if DEV_MODE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Shared secret configured on the Supabase Database Webhook itself,
# sent back as the X-Webhook-Secret header. Generate a long random value.
# Only required if DEV_MODE=false
SUPABASE_WEBHOOK_SECRET=generate-a-long-random-string

# CORS allowed origins - comma-separated list of frontend URLs
# For production: https://your-frontend-domain.com
# For development: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Timezone for cron-based automations (weekly briefing, etc.)
# Available timezones: UTC, America/New_York, America/Los_Angeles, America/Chicago,
# Europe/London, Europe/Paris, Europe/Berlin, Asia/Tokyo, Asia/Shanghai,
# Asia/Singapore, Australia/Sydney, Pacific/Auckland, etc.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
SCHEDULER_TIMEZONE=UTC
